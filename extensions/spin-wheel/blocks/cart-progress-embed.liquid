{%- comment -%}
  GreenTee Spin to Win: cart progress bar as an app embed, for themes whose
  cart drawer (or cart page) does not accept app blocks. Enable it under
  Theme settings > App embeds. It renders a hidden template; the script clones
  it into the drawer and the cart page at the selectors below, and again
  whenever the theme re-renders those containers. Same gates, copy and
  behaviour as the "Spin to Win cart progress" block.
{%- endcomment -%}

{%- liquid
  assign mode = shop.metafields.greentee_spin.campaign_mode | downcase | strip
  assign cart_currency = cart.currency.iso_code
  comment
    In the theme editor (design mode) the bar always renders, so it can be
    placed and styled whatever the campaign state. On the storefront it needs
    a live campaign, the shop currency and tax-exclusive prices.
  endcomment
  assign preview_flag = ''
  assign show = false
  if request.design_mode
    assign preview_flag = 'true'
    assign show = true
  elsif mode == 'off' or mode == 'test'
    assign show = false
  elsif cart_currency != shop.currency or cart.taxes_included
    assign show = false
  else
    assign show = true
  endif
-%}

{%- if show -%}
  <template
    data-gt-cartbar-template
    data-drawer-selector="{{ block.settings.drawer_target | escape }}"
    data-drawer-position="{{ block.settings.drawer_place }}"
    data-page-selector="{{ block.settings.page_target | escape }}"
    data-page-position="{{ block.settings.page_place }}"
  >
    <gt-cart-progress
      class="gt-cartbar gt-cartbar--embed"
      hidden
      data-gt-cartbar
      data-preview="{{ preview_flag }}"
      data-proxy-path="{{ block.settings.proxy_path | default: '/apps/spin' | escape }}"
      data-currency="{{ cart_currency }}"
      data-locale="{{ request.locale.iso_code }}"
      data-copy-remaining="{{ block.settings.copy_remaining | default: 'Add [amount] more to unlock a wheel spin' | escape }}"
      data-copy-reached="{{ block.settings.copy_reached | default: 'Wheel spin unlocked. Take it after checkout.' | escape }}"
    data-icon="{% if block.settings.show_icon %}true{% endif %}"
    data-margin="{{ block.settings.margin_block }}"
    >
        <span class="gt-cartbar__marker" data-marker aria-hidden="true"></span>
        <span class="gt-cartbar__tier" data-tier aria-hidden="true"></span>
      </div>
    </gt-cart-progress>
  </template>

  <script src="{{ 'cart-progress.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Spin to Win cart (embed)",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "For themes whose cart drawer does not take app blocks. Injects the one-line Spin to Win banner into the drawer and the cart page at the selectors below, and keeps it current as the cart changes. Hidden automatically outside the campaign."
    },
    {
      "type": "header",
      "content": "Cart drawer"
    },
    {
      "type": "text",
      "id": "drawer_target",
      "label": "Element to attach to",
      "info": "CSS selector inside the cart drawer (the \"Your cart\" panel, not the quick-add drawer). Leave blank to skip the drawer.",
      "default": "cart-drawer .cart-drawer__top"
    },
    {
      "type": "select",
      "id": "drawer_place",
      "label": "Where",
      "options": [
        { "value": "after", "label": "After that element" },
        { "value": "before", "label": "Before that element" },
        { "value": "prepend", "label": "Inside, at the top" },
        { "value": "append", "label": "Inside, at the bottom" }
      ],
      "default": "append"
    },
    {
      "type": "header",
      "content": "Cart page"
    },
    {
      "type": "text",
      "id": "page_target",
      "label": "Element to attach to",
      "info": "CSS selector on the cart page. Leave blank to skip the page (for example when the block is placed there instead).",
      "default": "cart-items .cart__head"
    },
    {
      "type": "select",
      "id": "page_place",
      "label": "Where",
      "options": [
        { "value": "after", "label": "After that element" },
        { "value": "before", "label": "Before that element" },
        { "value": "prepend", "label": "Inside, at the top" },
        { "value": "append", "label": "Inside, at the bottom" }
      ],
      "default": "after"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "copy_remaining",
      "label": "Below the threshold",
      "info": "[amount] is replaced with what is still needed.",
      "default": "Add [amount] more to unlock a wheel spin"
    },
    {
      "type": "text",
      "id": "copy_reached",
      "label": "At or above the threshold",
      "default": "Wheel spin unlocked. Take it after checkout."
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show the wheel icon",
      "default": true
    },
    {
      "type": "range",
      "id": "margin_block",
      "label": "Space above and below",
      "info": "Use this to keep it clear of other banners in the drawer.",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "info": "Must match the app proxy in shopify.app.toml. Leave as /apps/spin.",
      "default": "/apps/spin"
    }
  ]
}
{% endschema %}
