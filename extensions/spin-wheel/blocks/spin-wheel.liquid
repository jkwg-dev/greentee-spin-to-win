{%- comment -%}
  GreenTee Spin to Win: the wheel, rendered as a full-screen overlay so the page feels like a
  modal that happens to have its own URL. Place this app block on the storefront page that the
  Thank you page links to (SPIN_PAGE_URL). It needs ?token=... in the URL; without a valid token
  it shows a plain message and nothing else. The server decides every outcome; this block only
  animates to the slice it is told.
{%- endcomment -%}

{%- liquid
  assign css_url = 'spin-page.css' | asset_url
  assign bg_image = ''
  if block.settings.background_image != blank
    assign bg_image = block.settings.background_image | image_url: width: 2000
  endif
-%}

<div
  class="gt-spin{% if block.settings.overlay %} gt-spin--overlay{% endif %}"
  data-gt-spin
  data-overlay="{{ block.settings.overlay }}"
  data-css="{{ css_url }}"
  data-proxy-path="{{ block.settings.proxy_path | default: '/apps/spin' | escape }}"
  data-back-label="{{ block.settings.back_label | default: 'Back to your order' | escape }}"
  style="
    --gtsw-navy: {{ block.settings.color_navy | default: '#1b2a3d' }};
    --gtsw-cream: {{ block.settings.color_cream | default: '#efe9dc' }};
    --gtsw-green: {{ block.settings.color_green | default: '#2e5a3e' }};
    --gtsw-gold: {{ block.settings.color_gold | default: '#c9a961' }};
    --gtsw-bg: {{ block.settings.background_color | default: '#fbfbfa' }};
    {% if bg_image != '' %}--gtsw-bg-image: url('{{ bg_image }}');{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="gt-spin__panel">
    <a class="gt-spin__close" data-close hidden aria-label="Close and return to your order">&times;</a>

    <header class="gt-spin__header">
      {%- if block.settings.eyebrow != blank -%}
        <p class="gt-spin__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if block.settings.heading != blank -%}
        <h1 class="gt-spin__heading">{{ block.settings.heading | escape }}</h1>
      {%- endif -%}
    </header>

    <p class="gt-spin__status" data-status role="status" aria-live="polite">Checking your order…</p>

    <div class="gt-spin__stage" data-stage hidden>
      <div class="gt-spin__pointer" aria-hidden="true">
        {%- comment -%} SVG so the pointer can carry a white stroke and stay visible on a same-coloured slice. {%- endcomment -%}
        <svg viewBox="0 0 40 46" focusable="false">
          <path d="M3 3h34L20 43z" fill="currentColor" stroke="#fff" stroke-width="3" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="gt-spin__rim" aria-hidden="true"></div>
      <div class="gt-spin__wheel" data-wheel role="img" aria-label="Prize wheel"></div>
      <div class="gt-spin__labels" data-labels aria-hidden="true"></div>
      <div class="gt-spin__hub" aria-hidden="true">
        <span class="gt-spin__hub-text">{{ block.settings.hub_text | escape }}</span>
      </div>
    </div>

    <div class="gt-spin__actions">
      <button type="button" class="gt-spin__button" data-spin hidden>
        {{ block.settings.button_label | default: 'Spin the wheel' | escape }}
      </button>
      <button type="button" class="gt-spin__button gt-spin__button--secondary" data-retry hidden>Try again</button>
    </div>

    <div class="gt-spin__meta" data-odds hidden>
      <p class="gt-spin__odds" data-odds-line></p>
      <p class="gt-spin__odds gt-spin__odds--note">
        The size and placement of the wheel's sections do not represent the actual chances.
      </p>
      {%- if block.settings.rules_url != blank -%}
        <p class="gt-spin__odds">
          <a class="gt-spin__rules" href="{{ block.settings.rules_url | escape }}" target="_blank" rel="noopener">
            {{ block.settings.rules_label | default: 'Full promotion rules' | escape }}
          </a>
        </p>
      {%- endif -%}
    </div>

    <div class="gt-spin__result" data-result hidden aria-live="polite"></div>

    <noscript><p class="gt-spin__status">Please enable JavaScript to spin the wheel.</p></noscript>
  </div>
</div>

{{ 'spin-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'spin-wheel.js' | asset_url }}" defer></script>
<script src="{{ 'spin-page.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Spin to Win wheel",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Cover the whole page (modal style)",
      "info": "Moves the block to the top of the page as a full-screen layer on a black backdrop, so nothing from the theme shows and it reads as a modal over checkout.",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spin to Win"
    },
    {
      "type": "text",
      "id": "hub_text",
      "label": "Centre text (optional)",
      "info": "Leave blank for a plain centre."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Spin button label",
      "default": "Spin the wheel"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "default": "Back to your order"
    },
    {
      "type": "url",
      "id": "rules_url",
      "label": "Promotion rules link",
      "info": "Shown under the odds only when set."
    },
    {
      "type": "text",
      "id": "rules_label",
      "label": "Rules link text",
      "default": "Full promotion rules"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (optional)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#fbfbfa"
    },
    {
      "type": "header",
      "content": "Wheel colours"
    },
    {
      "type": "color",
      "id": "color_navy",
      "label": "Navy slices and text",
      "default": "#1b2a3d"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Cream slices and text",
      "default": "#efe9dc"
    },
    {
      "type": "color",
      "id": "color_green",
      "label": "Green slices",
      "default": "#2e5a3e"
    },
    {
      "type": "color",
      "id": "color_gold",
      "label": "Ring and centre",
      "default": "#c9a961"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "info": "Must match the app proxy in shopify.app.toml. Leave as /apps/spin.",
      "default": "/apps/spin"
    }
  ]
}
{% endschema %}
