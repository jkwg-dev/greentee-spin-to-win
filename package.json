{
  "name": "greentee-spin-to-win",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "dev": "shopify app dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "deploy": "shopify app deploy",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "env": "shopify app env",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p extensions/spin-status/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shopify": "shopify",
    "setup:metafields": "node --env-file-if-exists=.env --import tsx scripts/setup-metafields.ts",
    "cleanup:test-data": "node --env-file-if-exists=.env --import tsx scripts/cleanup-test-data.ts",
    "check:scopes": "node --env-file-if-exists=.env --import tsx scripts/check-scopes.ts"
  },
  "dependencies": {
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@shopify/cli": "^3.91.0",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@vercel/react-router": "^1.3.6",
    "jsdom": "^26",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.1.11"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  }
}
