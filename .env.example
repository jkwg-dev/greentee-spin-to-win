# Copy to .env for local development. `shopify app dev` also injects
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET and SHOPIFY_APP_URL automatically.

# off | test | live. `off` is the kill switch. Start in `off`.
CAMPAIGN_MODE=off

# Campaign window, wall-clock in America/Vancouver (defaults shown).
CAMPAIGN_START=2026-10-01T00:00:00
CAMPAIGN_END=2026-11-02T09:00:00

# Eligibility
MIN_SUBTOTAL_CAD=300

# Test mode
TEST_TAG=test-user
TEST_EMAILS=
TEST_BYPASS_MIN_SUBTOTAL=false

# Regular priced collections the discount codes apply to. Smart collections that
# exclude reduced-price products, so sale items drop out automatically.
COLLECTION_CLUBS=gid://shopify/Collection/342836052158
COLLECTION_ACCESSORIES=gid://shopify/Collection/342836215998
COLLECTION_APPAREL=gid://shopify/Collection/342836150462

# HMAC key for outcome derivation and spin URL tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this mid-campaign changes every not-yet-spun outcome. Do not rotate it.
SPIN_SECRET=

# Public URL of this server (production). Optional in development; overrides
# SHOPIFY_APP_URL when set. The extension gets this URL from its own settings.
APP_URL=

# Storefront page that holds the wheel block (theme app extension). Use the
# primary domain in production. Defaults to https://{SHOP_DOMAIN}/pages/spin-to-win.
SPIN_PAGE_URL=https://REPLACE.myshopify.com/pages/spin-to-win

# Shopify app credentials from the Dev Dashboard, and the single store served.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOP_DOMAIN=REPLACE.myshopify.com
# Optional, comma separated. Extra hosts accepted as the shop in extension
# session tokens, e.g. the primary storefront domain. Scheme, port, path, case
# and surrounding spaces are all ignored. Set this when the logs show
# status.unauthorized with reason "shop" and a tokenDestHost that is not
# SHOP_DOMAIN; that log line prints both sides of the comparison.
SHOP_ALT_DOMAINS=
